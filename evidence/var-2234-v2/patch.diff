+partial class GeneratedMessagePackResolver {
+
+	internal sealed class HolderFormatter : MsgPack::Formatters.IMessagePackFormatter<global::Holder>
+	{
+
+		public void Serialize(ref MsgPack::MessagePackWriter writer, global::Holder value, MsgPack::MessagePackSerializerOptions options)
+		{
+			if (value == null)
+			{
+				writer.WriteNil();
